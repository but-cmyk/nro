      "category": "Null-Check Player/Zone",
      "template": "- Luôn null-check Player và Zone trước khi thao tác, đặc biệt trong callback async.",
      "severity": "HIGH",
      "enabled": true,
      "violation_count": 0,
      "last_violated": null,
      "confirmed_useful": true
    },
    {
      "id": "concurrent_modification",
      "regex": "CopyOnWriteArrayList|ConcurrentHashMap|Collections\\.synchronizedList",
