# Ignore local configuration files with passwords/API keys
data/config/alyra.properties
data/config/redis.properties
.env
.env.*
!.env.example

# Logs may contain player PII
log/
logs/

# IDE files
.idea/
*.iml
nbproject/private/
build/
out/
target/
classes/
dist/
nbdist/

